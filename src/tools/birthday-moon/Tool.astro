---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { localePath } from '../../i18n/locales';
import { getBrand, site } from '../../config/site';
import Icon from '../../components/Icon.astro';
import { MAX_DATE, MIN_DATE, ZONES } from './logic';
import { starField } from './render';
import i18n from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const card = {
  brand: getBrand(locale).name,
  url: `${new URL(site.url).host}${localePath(locale, '/birthday-moon/')}`,
};
const stars = `--bm-stars: url("data:image/svg+xml,${encodeURIComponent(starField('birthday-moon'))}")`;
---

<div class="tool" data-tool="birthday-moon" data-card={JSON.stringify(card)} {...i18nAttrs(locale, s.client)}>
  <div class="bm-inputs">
    <div class="field bm-date-field">
      <label for="bm-date">{s.dateLabel}</label>
      <div class="bm-date-row">
        <input id="bm-date" type="date" min={MIN_DATE} max={MAX_DATE} required />
        <button class="btn" type="button" id="bm-today">{s.today}</button>
      </div>
    </div>
    <div class="field">
      <label for="bm-time">{s.timeLabel}</label>
      <input id="bm-time" type="time" />
    </div>
    <div class="field">
      <label for="bm-zone">{s.zoneLabel}</label>
      <select id="bm-zone">
        {ZONES.map((zone) => <option value={zone}>{s.zoneNames[zone] ?? zone}</option>)}
      </select>
    </div>
  </div>
  <p class="hint bm-hint">{s.timeHint}</p>
  <p class="notice error" id="bm-error" hidden>{s.client.invalid}</p>

  <section class="bm-sky" id="bm-sky" style={stars}>
    <div class="seg bm-hemi" role="radiogroup" aria-label={s.hemiAria}>
      <label><input type="radio" name="bm-hemi" value="n" checked /><span>{s.north}</span></label>
      <label><input type="radio" name="bm-hemi" value="s" /><span>{s.south}</span></label>
    </div>
    <div class="bm-moon" id="bm-moon"></div>
    <div class="bm-caption" aria-live="polite">
      <p class="bm-when" id="bm-when"></p>
      <h2 class="bm-phase" id="bm-phase">&nbsp;</h2>
      <p class="bm-lunar" id="bm-lunar" hidden></p>
    </div>
    <div class="bm-figures">
      <div><span class="bm-fig-value" id="bm-fraction">–</span><span class="bm-fig-label">{s.client.statFraction}</span></div>
      <div><span class="bm-fig-value" id="bm-age">–</span><span class="bm-fig-label">{s.client.statAge}</span></div>
      <div><span class="bm-fig-value bm-trend" id="bm-trend">–</span><span class="bm-fig-label" id="bm-trend-label"></span></div>
    </div>
    <p class="bm-visible"><Icon name="Eye" size={16} /><span id="bm-visible"></span></p>
  </section>

  <div class="row bm-actions">
    <button class="btn primary" type="button" id="bm-download"><Icon name="Download" size={18} /><span>{s.download}</span></button>
    <button class="btn" type="button" id="bm-copy"><Icon name="Link" size={18} /><span>{s.copyLink}</span></button>
  </div>
  <p class="notice error" id="bm-card-error" hidden>{s.client.cardFailed}</p>

  <section class="bm-panel">
    <h3><Icon name="Orbit" size={18} />{s.cycleTitle}</h3>
    <p class="bm-nearest" id="bm-nearest"></p>
    <div class="bm-track" aria-hidden="true"><span class="bm-track-fill" id="bm-track-fill"></span><span class="bm-track-dot" id="bm-track-dot"></span></div>
    <ol class="bm-cycle" id="bm-cycle"></ol>
  </section>

  <section class="bm-panel">
    <h3><Icon name="CalendarHeart" size={18} />{s.yearsTitle}</h3>
    <p class="hint bm-panel-hint">{s.yearsHint}</p>
    <ul class="bm-list" id="bm-years"></ul>
  </section>

  <section class="bm-panel">
    <h3><Icon name="Repeat" size={18} />{s.echoTitle}</h3>
    <p class="bm-panel-text">{s.echoIntro}</p>
    <ul class="bm-list" id="bm-echoes"></ul>
  </section>

  <p class="hint">{s.method}</p>
</div>

<script>
  import { $, $$, copyText, downloadBlob, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import { formatDate, formatFixed, formatNumber, plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import { isValidTimeZone } from '../timezone-converter/logic';
  import { dayName, monthName, solarToLunar } from '../lunar-converter/logic';
  import { toDayNumber, toISODate, type YMD } from '../date-diff/logic';
  import {
    fullMoonBirthdays,
    instantOf,
    localDate,
    lunarDay,
    metonicEchoes,
    moonReport,
    normalizeInput,
    parseDate,
    parseShareQuery,
    phaseName,
    shareQuery,
    type EventKind,
    type MoonInput,
    type MoonReport,
    type PhaseEvent,
  } from './logic';
  import { moonSvg, seededRandom } from './render';
  import type { Strings } from './i18n';

  const root = $('[data-tool="birthday-moon"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const card = JSON.parse(root.dataset.card ?? '{}') as { brand: string; url: string };
  const intl = LOCALE_INFO[locale].intl;
  const prefKey = `birthday-moon:${locale}`;

  const dateInput = $<HTMLInputElement>('#bm-date', root);
  const timeInput = $<HTMLInputElement>('#bm-time', root);
  const zoneSelect = $<HTMLSelectElement>('#bm-zone', root);
  const hemiRadios = $$<HTMLInputElement>('input[name="bm-hemi"]', root);
  const errorEl = $('#bm-error', root);
  const cardError = $('#bm-card-error', root);
  const moonEl = $('#bm-moon', root);
  const whenEl = $('#bm-when', root);
  const phaseEl = $('#bm-phase', root);
  const lunarEl = $('#bm-lunar', root);
  const fractionEl = $('#bm-fraction', root);
  const ageEl = $('#bm-age', root);
  const trendEl = $('#bm-trend', root);
  const trendLabel = $('#bm-trend-label', root);
  const visibleEl = $('#bm-visible', root);
  const nearestEl = $('#bm-nearest', root);
  const trackFill = $('#bm-track-fill', root);
  const trackDot = $('#bm-track-dot', root);
  const cycleEl = $('#bm-cycle', root);
  const yearsEl = $('#bm-years', root);
  const echoesEl = $('#bm-echoes', root);
  const downloadBtn = $<HTMLButtonElement>('#bm-download', root);
  const copyBtn = $<HTMLButtonElement>('#bm-copy', root);

  /* ---------- Zones ---------- */
  let deviceZone = 'UTC';
  try {
    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    if (zone && isValidTimeZone(zone)) deviceZone = zone;
  } catch {
    /* keep UTC */
  }
  const zoneText = (zone: string) => zone.replace(/_/g, ' ');
  // City names of the zones rendered on the server; any other zone is shown by its IANA id.
  const cityNames = new Map(Array.from(zoneSelect.options).map((o) => [o.value, o.text]));
  const zoneName = (zone: string) => cityNames.get(zone) ?? zoneText(zone);

  /** Adds a zone that is not in the list (the device's own zone, or one from a share link). */
  function ensureZone(zone: string) {
    if (Array.from(zoneSelect.options).some((o) => o.value === zone)) return;
    const label = zone === deviceZone ? t(s.deviceZone, { zone: zoneText(zone) }) : zoneText(zone);
    zoneSelect.prepend(new Option(label, zone));
  }
  ensureZone(deviceZone);

  /* ---------- State ---------- */
  const defaultZone = s.defaultZone === 'device' ? deviceZone : s.defaultZone;
  const todayIn = (zone: string): YMD => localDate(Date.now(), zone);
  const fallback: MoonInput = { date: toISODate(todayIn(defaultZone)), time: '', zone: defaultZone, south: false };
  const shared = parseShareQuery(location.search);
  let fromLink = shared !== null;
  let input: MoonInput = shared
    ? normalizeInput({ ...fallback, ...shared }, fallback)
    : normalizeInput(loadPref<unknown>(prefKey, null), fallback);
  let report: MoonReport | null = null;

  /* ---------- Formatting ---------- */
  const utcDate = (d: YMD) => new Date(Date.UTC(d.y, d.m - 1, d.d, 12));
  const fullDate = (d: YMD) => formatDate(utcDate(d), locale, { dateStyle: 'full', timeZone: 'UTC' });
  const longDate = (d: YMD) => formatDate(utcDate(d), locale, { dateStyle: 'long', timeZone: 'UTC' });
  const percent = (fraction: number) => formatFixed(fraction * 100, 1, locale);
  const ageText = (age: number) => t(s.ageValue, { n: formatFixed(age, 1, locale) });
  const timeFormat = (zone: string) =>
    new Intl.DateTimeFormat(intl, { timeZone: zone, hour: 'numeric', minute: '2-digit', hourCycle: s.clock24 ? 'h23' : 'h12' });
  const dayFormat = (zone: string) => new Intl.DateTimeFormat(intl, { timeZone: zone, month: 'short', day: 'numeric' });
  /** Compact "8/15" for the five timeline columns. */
  const shortDayFormat = (zone: string) => new Intl.DateTimeFormat(intl, { timeZone: zone, month: 'numeric', day: 'numeric' });

  function relative(at: number, date: YMD, zone: string): string {
    const diff = toDayNumber(localDate(at, zone)) - toDayNumber(date);
    if (diff === 0) return s.sameDay;
    return plural(locale, Math.abs(diff), diff < 0 ? s.daysAgo : s.daysLater);
  }

  /** Idealized icon for a principal phase. */
  const EVENT_ART: Record<EventKind, { fraction: number; waxing: boolean }> = {
    new: { fraction: 0, waxing: true },
    firstQuarter: { fraction: 0.5, waxing: true },
    full: { fraction: 1, waxing: true },
    lastQuarter: { fraction: 0.5, waxing: false },
  };

  function mini(fraction: number, waxing: boolean, size = 32): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = 'bm-mini';
    // moonSvg only interpolates numbers and fixed markup.
    span.innerHTML = moonSvg({ fraction, waxing, south: input.south, id: '', size, detail: false });
    return span;
  }

  function el(tag: string, className: string, text = ''): HTMLElement {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = text;
    return node;
  }

  /* ---------- Rendering ---------- */
  function phaseLabel(r: MoonReport, date: YMD): { name: string; reading?: string; lunar?: string } {
    if (s.lunar === 'japanese') {
      const day = lunarDay(date, 540);
      const names = Object.fromEntries(Object.entries(s.traditional ?? {}).map(([k, v]) => [k, v.name]));
      const name = phaseName(r.phase, s.phases, day, names);
      const trad = s.traditional?.[day];
      const usedTrad = trad?.name === name;
      const line = t(s.lunarLine ?? '', { n: day }) + (trad && !usedTrad ? `・${trad.name}（${trad.reading}）` : '');
      return { name, reading: usedTrad ? trad.reading : undefined, lunar: line };
    }
    if (s.lunar === 'chinese') {
      const l = solarToLunar(date);
      const lunar = l ? t(s.lunarLine ?? '', { date: `${monthName(l.month, l.isLeap)}${dayName(l.day)}` }) : undefined;
      return { name: s.phases[r.phase], lunar };
    }
    return { name: s.phases[r.phase] };
  }

  function render() {
    const date = parseDate(input.date);
    errorEl.hidden = !!date;
    if (!date) return;
    const zone = input.zone;
    const at = instantOf(date, input.time, zone);
    const r = moonReport(at, zone);
    report = r;
    const label = phaseLabel(r, date);
    const time = timeFormat(zone).format(at);

    moonEl.innerHTML = moonSvg({
      fraction: r.fraction,
      waxing: r.waxing,
      south: input.south,
      id: 'bm-main',
      size: 360,
      label: t(s.moonLabel, { date: longDate(date), phase: label.name, p: percent(r.fraction) }),
    });
    whenEl.textContent = `${fullDate(date)} · ${t(input.time ? s.when : s.whenDefault, { time, zone: zoneName(zone) })}`;
    if (label.reading) {
      const ruby = document.createElement('ruby');
      ruby.append(label.name, el('rt', '', label.reading));
      phaseEl.replaceChildren(ruby);
    } else {
      phaseEl.textContent = label.name;
    }
    lunarEl.hidden = !label.lunar;
    lunarEl.textContent = label.lunar ?? '';
    fractionEl.textContent = `${percent(r.fraction)}%`;
    ageEl.textContent = ageText(r.age);
    const trend = r.waxing ? s.waxing : s.waning;
    trendEl.textContent = trend.value;
    trendLabel.textContent = trend.note;
    visibleEl.textContent = s.visibility[r.phase];

    renderCycle(r, date, zone);
    renderYears(date, zone);
    renderEchoes(date, zone);
  }

  function renderCycle(r: MoonReport, date: YMD, zone: string) {
    const day = dayFormat(zone);
    const time = timeFormat(zone);
    const item = (e: PhaseEvent) => t(s.nearestItem, { date: day.format(e.at), rel: relative(e.at, date, zone) });
    nearestEl.textContent = t(s.nearest, { full: item(r.nearestFull), new: item(r.nearestNew) });

    // The track runs from the centre of the first column to the centre of the last, piecewise per event.
    const events = r.cycle;
    let pos = 0;
    for (let i = 0; i < events.length - 1; i++) {
      if (r.at >= events[i].at && r.at <= events[i + 1].at) {
        pos = (i + (r.at - events[i].at) / (events[i + 1].at - events[i].at)) / (events.length - 1);
      }
    }
    trackFill.style.width = `${pos * 100}%`;
    trackDot.style.left = `${pos * 100}%`;

    const closest = events.reduce((a, b) => (Math.abs(b.at - r.at) < Math.abs(a.at - r.at) ? b : a));
    const short = shortDayFormat(zone);
    cycleEl.replaceChildren(
      ...events.map((e) => {
        const li = document.createElement('li');
        li.classList.toggle('is-near', e === closest);
        const art = EVENT_ART[e.kind];
        li.append(
          mini(art.fraction, art.waxing),
          el('span', 'bm-ev-name', s.events[e.kind]),
          el('span', 'bm-ev-date', short.format(e.at)),
          el('span', 'bm-ev-time', time.format(e.at)),
          el('span', 'bm-ev-rel', relative(e.at, date, zone)),
        );
        return li;
      }),
    );
  }

  function renderYears(date: YMD, zone: string) {
    const list = fullMoonBirthdays(date, input.time, zone, todayIn(zone));
    if (list.length === 0) {
      yearsEl.replaceChildren(el('li', 'bm-empty', s.yearsNone));
      return;
    }
    yearsEl.replaceChildren(
      ...list.map((y) => {
        const li = document.createElement('li');
        const text = el('span', 'bm-item-text');
        text.append(el('strong', '', longDate(y.date)));
        li.append(
          mini(y.fraction, y.waxing, 34),
          text,
          el('span', `bm-tag${y.exact ? ' is-exact' : ''}`, y.exact ? s.yearsExact : t(s.yearsNear, { p: formatNumber(y.fraction * 100, 0, locale) })),
        );
        return li;
      }),
    );
  }

  function renderEchoes(date: YMD, zone: string) {
    echoesEl.replaceChildren(
      ...metonicEchoes(date, input.time, zone).map((e) => {
        const li = document.createElement('li');
        const text = el('span', 'bm-item-text');
        const diff = `${e.ageDiff >= 0 ? '+' : '−'}${formatFixed(Math.abs(e.ageDiff), 1, locale)}`;
        text.append(
          el('span', 'bm-item-eyebrow', t(s.echoWhen, { years: e.years })),
          el('strong', '', longDate(e.date)),
          el('span', 'bm-item-sub', t(s.echoValue, { age: formatFixed(e.age, 1, locale), diff })),
        );
        li.append(mini(e.fraction, e.waxing, 34), text, el('span', 'bm-tag', `${percent(e.fraction)}%`));
        return li;
      }),
    );
  }

  /* ---------- Form ---------- */
  function writeForm() {
    ensureZone(input.zone);
    dateInput.value = input.date;
    timeInput.value = input.time;
    zoneSelect.value = input.zone;
    for (const radio of hemiRadios) radio.checked = (radio.value === 's') === input.south;
  }

  function onChange() {
    input = normalizeInput(
      {
        date: dateInput.value,
        time: timeInput.value,
        zone: zoneSelect.value,
        south: hemiRadios.find((r) => r.checked)?.value === 's',
      },
      input,
    );
    // An empty or broken date shows the error instead of silently keeping the old one.
    if (!parseDate(dateInput.value)) {
      errorEl.hidden = false;
      return;
    }
    savePref(prefKey, input);
    if (fromLink) {
      // The page was opened from a share link; drop the query so a reload shows the user's own date.
      history.replaceState(null, '', location.pathname + location.hash);
      fromLink = false;
    }
    render();
  }

  for (const node of [dateInput, timeInput, zoneSelect]) node.addEventListener('change', onChange);
  dateInput.addEventListener('input', () => {
    if (parseDate(dateInput.value)) onChange();
  });
  for (const radio of hemiRadios) radio.addEventListener('change', onChange);
  $('#bm-today', root).addEventListener('click', () => {
    dateInput.value = toISODate(todayIn(zoneSelect.value));
    timeInput.value = '';
    onChange();
  });

  /* ---------- Share link ---------- */
  copyBtn.addEventListener('click', async () => {
    const url = `${location.origin}${location.pathname}${shareQuery(input)}`;
    if (!(await copyText(url))) return;
    const labelEl = copyBtn.querySelector('span')!;
    const original = labelEl.textContent;
    labelEl.textContent = document.documentElement.dataset.copied || original;
    copyBtn.classList.add('is-done');
    window.setTimeout(() => {
      labelEl.textContent = original;
      copyBtn.classList.remove('is-done');
    }, 1400);
  });

  /* ---------- Card (PNG) ---------- */
  function fit(ctx: CanvasRenderingContext2D, text: string, weight: number, size: number, family: string, max: number) {
    let px = size;
    do {
      ctx.font = `${weight} ${px}px ${family}`;
      px -= 2;
    } while (ctx.measureText(text).width > max && px > 12);
  }

  async function makeCard(): Promise<Blob | null> {
    const date = parseDate(input.date);
    if (!date || !report) return null;
    const r = report;
    const label = phaseLabel(r, date);
    const W = 1080;
    const H = 1350;
    const canvas = document.createElement('canvas');
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;
    const family = getComputedStyle(root).fontFamily || 'sans-serif';

    const sky = ctx.createLinearGradient(0, 0, 0, H);
    sky.addColorStop(0, '#080b1d');
    sky.addColorStop(0.55, '#121838');
    sky.addColorStop(1, '#1d2550');
    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, W, H);
    const rand = seededRandom(input.date);
    // Keep stars out of the text bands so they never look like punctuation.
    const inText = (x: number, y: number) => Math.abs(x - W / 2) < 470 && ((y > 60 && y < 260) || (y > 1030 && y < 1320));
    for (let i = 0; i < 180; i++) {
      const [x, y, alpha, big, size] = [rand() * W, rand() * H, rand(), rand(), rand()];
      if (inText(x, y)) continue;
      ctx.globalAlpha = 0.2 + alpha * 0.6;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(x, y, big < 0.1 ? 2.2 : 0.8 + size * 0.9, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    const svg = moonSvg({ fraction: r.fraction, waxing: r.waxing, south: input.south, id: 'card', size: 800 });
    const img = new Image();
    img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
    await img.decode();
    const size = 780;
    ctx.drawImage(img, (W - size) / 2, 250, size, size);

    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = 'rgba(214, 221, 255, 0.62)';
    fit(ctx, s.cardTitle, 600, 30, family, W - 160);
    ctx.fillText(s.cardTitle, W / 2, 112);
    ctx.fillStyle = '#ffffff';
    const dateText = longDate(date);
    fit(ctx, dateText, 700, 64, family, W - 140);
    ctx.fillText(dateText, W / 2, 190);
    if (input.time) {
      ctx.fillStyle = 'rgba(214, 221, 255, 0.75)';
      const when = t(s.when, { time: timeFormat(input.zone).format(r.at), zone: zoneName(input.zone) });
      fit(ctx, when, 500, 32, family, W - 160);
      ctx.fillText(when, W / 2, 240);
    }

    ctx.fillStyle = '#ffffff';
    fit(ctx, label.name, 700, 92, family, W - 140);
    ctx.fillText(label.name, W / 2, 1110);
    const figures = `${s.statFraction} ${percent(r.fraction)}%  ·  ${s.statAge} ${ageText(r.age)}`;
    ctx.fillStyle = 'rgba(232, 236, 255, 0.85)';
    fit(ctx, figures, 500, 36, family, W - 160);
    ctx.fillText(figures, W / 2, 1172);
    if (label.lunar) {
      ctx.fillStyle = '#e3cf96';
      fit(ctx, label.lunar, 500, 32, family, W - 160);
      ctx.fillText(label.lunar, W / 2, 1226);
    }
    ctx.fillStyle = 'rgba(214, 221, 255, 0.45)';
    const footer = `${card.brand}  ${card.url}`;
    fit(ctx, footer, 500, 26, family, W - 160);
    ctx.fillText(footer, W / 2, 1302);

    return new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
  }

  downloadBtn.addEventListener('click', async () => {
    downloadBtn.disabled = true;
    let blob: Blob | null = null;
    try {
      blob = await makeCard();
    } catch {
      blob = null;
    }
    downloadBtn.disabled = false;
    cardError.hidden = !!blob;
    if (blob) downloadBlob(blob, `birthday-moon-${input.date}.png`);
  });

  writeForm();
  render();
</script>

<style>
  .bm-inputs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .bm-date-field {
    grid-column: 1 / -1;
  }
  @media (min-width: 720px) {
    .bm-inputs {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 1fr);
    }
    .bm-date-field {
      grid-column: auto;
    }
  }
  .bm-inputs input,
  .bm-inputs select,
  .bm-inputs .btn {
    height: 44px;
  }
  .bm-date-row {
    display: flex;
    gap: 8px;
  }
  .bm-date-row input {
    flex: 1;
    min-width: 0;
  }
  .bm-hint {
    margin: -6px 0 0;
  }

  /* ---------- Night sky ---------- */
  .bm-sky {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 14px;
    padding: 16px 16px 22px;
    border-radius: var(--radius);
    color: #e6e9f7;
    text-align: center;
    overflow: hidden;
    background: radial-gradient(110% 70% at 50% 32%, #232d5c 0%, #121836 52%, #0a0d22 100%) #0b0f26;
    box-shadow: var(--shadow);
  }
  /* Stars fade out behind the text so they never read as stray punctuation. */
  .bm-sky::before {
    content: '';
    position: absolute;
    inset: 0;
