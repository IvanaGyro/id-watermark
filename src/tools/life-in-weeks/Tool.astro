---
import { i18nAttrs, pickStrings, type ToolProps } from '../../i18n/tool';
import { localePath } from '../../i18n/locales';
import { plural, t } from '../../i18n/format';
import { getBrand, site } from '../../config/site';
import Icon from '../../components/Icon.astro';
import { DEFAULT_SETTINGS, STAGES } from './logic';
import { swatchColor } from './draw';
import i18n, { type LegendKey } from './i18n';

type Props = ToolProps;
const { locale = 'zh-TW' } = Astro.props;
const s = pickStrings(i18n, locale);
const c = s.client;
const d = DEFAULT_SETTINGS;
const pageUrl = `${new URL(site.url).host}${localePath(locale, '/life-in-weeks/')}`;
const legendKeys: (LegendKey | (typeof STAGES)[number])[] = ['lived', ...STAGES, 'current', 'ahead', 'bonus'];
const legendLabel = (k: string) => (k in c.legend ? c.legend[k as LegendKey] : c.stages[k as (typeof STAGES)[number]]);
const stageFields = [
  ['schoolStart', s.schoolStart, d.schoolStart],
  ['schoolEnd', s.schoolEnd, d.schoolEnd],
  ['retire', s.retire, d.retire],
] as const;
---

<div class="tool lw" data-tool="life-in-weeks" data-brand={getBrand(locale).name} data-url={pageUrl} {...i18nAttrs(locale, s.client)}>
  <div class="lw-inputs">
    <div class="field">
      <label for="lw-birth">{s.birthLabel}</label>
      <input id="lw-birth" type="date" min="1900-01-01" value={d.birth} autocomplete="bday" />
    </div>
    <div class="field">
      <label for="lw-lifespan">{s.lifespanLabel}</label>
      <div class="lw-unit">
        <input id="lw-lifespan" type="number" inputmode="numeric" min="1" max="120" step="1" value={d.lifespan} />
        <span>{s.ageUnit}</span>
      </div>
    </div>
    <p class="hint lw-assume">{s.lifespanHint}</p>
  </div>
  <p class="notice error" id="lw-error" role="alert" hidden></p>

  <section class="lw-hero" id="lw-hero">
    <p class="lw-kicker">{s.heroLabel}</p>
    <div class="lw-pct"><span id="lw-pct-int">–</span><span class="lw-pct-frac" id="lw-pct-frac"></span><span class="lw-pct-sign">%</span></div>
    <div class="lw-bar" id="lw-bar" role="progressbar" aria-label={s.progressAria} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="lw-fill" id="lw-fill"></span>
    </div>
    <div class="lw-meta"><span id="lw-lived"></span><span id="lw-ahead"></span></div>
    <p class="lw-now" id="lw-now"></p>
    <p class="lw-bonus" id="lw-bonus" hidden></p>
  </section>

  <div class="lw-main">
    <section class="lw-board" aria-labelledby="lw-grid-title">
      <div class="lw-board-head">
        <h3 id="lw-grid-title">{s.gridTitle}</h3>
        <p class="hint">{s.gridCaption}</p>
      </div>
      <ul class="lw-legend" id="lw-legend">
        {
          legendKeys.map((k) => (
            <li data-key={k} hidden={!['lived', 'current', 'ahead'].includes(k)}>
              <span class="lw-swatch" style={`background:${swatchColor(k)}`} />
              {legendLabel(k)}
            </li>
          ))
        }
      </ul>
      <div class="lw-canvas-wrap" id="lw-wrap">
        <canvas id="lw-canvas" role="img" aria-label={s.gridTitle}></canvas>
      </div>
      <p class="lw-cell" id="lw-cell" aria-live="polite">{c.cellHint}</p>
      <div class="lw-actions">
        <button class="btn primary" type="button" id="lw-download"><Icon name="ImageDown" size={18} />{s.download}</button>
        <button class="btn" type="button" id="lw-share"><Icon name="Link" size={18} /><span id="lw-share-label">{s.share}</span></button>
      </div>
      <p class="hint lw-share-hint">{s.shareHint}</p>
    </section>

    <aside class="lw-side">
      <section class="lw-left" aria-labelledby="lw-left-title">
        <h3 id="lw-left-title">{t(c.leftTitle, { lifespan: d.lifespan })}</h3>
        <ul class="lw-counts">
          {
            c.countKeys.map((k) => (
              <li>
                <Icon name={s.countIcons[k]} size={22} class="lw-count-icon" />
                <span class="lw-count-value">
                  <span class="lw-count-n" id={`lw-n-${k}`}>–</span>
                  {c.counts[k].suffix && <span class="lw-count-suffix">{c.counts[k].suffix}</span>}
                </span>
                <span class="lw-count-label" id={`lw-u-${k}`}>{plural(locale, 2, c.counts[k].label)}</span>
              </li>
            ))
          }
        </ul>
        <p class="hint" id="lw-counts-note">{t(c.countsNote, { lifespan: d.lifespan })}</p>
      </section>

      <section class="lw-stages" aria-labelledby="lw-stages-title">
        <h3 id="lw-stages-title">{s.stagesTitle}</h3>
        <label class="check"><input type="checkbox" id="lw-stages-on" checked={d.stagesOn} /> {s.stagesOn}</label>
        <div class="lw-stage-fields" id="lw-stage-fields" hidden={!d.stagesOn}>
          {
            stageFields.map(([key, label, value]) => (
              <div class="field">
                <label for={`lw-${key}`}>{label}</label>
                <div class="lw-unit">
                  <input id={`lw-${key}`} data-stage={key} type="number" inputmode="numeric" min="0" max="120" step="1" value={value} />
                  <span>{s.ageUnit}</span>
                </div>
              </div>
            ))
          }
        </div>
        <p class="hint" id="lw-stages-note" hidden={!d.stagesOn}>{s.stagesNote}</p>
      </section>
    </aside>
  </div>

  <section class="lw-people" aria-labelledby="lw-people-title">
    <h3 id="lw-people-title"><Icon name="HeartHandshake" size={22} class="lw-people-icon" />{s.peopleTitle}</h3>
    <p class="hint">{s.peopleIntro}</p>
    <ol class="lw-people-list" id="lw-people"></ol>
    <button class="btn small" type="button" id="lw-add"><Icon name="Plus" size={16} />{s.add}</button>
    <p class="lw-people-note">{s.peopleNote}</p>
  </section>

  <template id="lw-person-tpl">
    <li class="lw-person">
      <div class="lw-person-fields">
        <div class="field lw-f-name">
          <label data-for="name">{s.nameLabel}</label>
          <input type="text" data-f="name" maxlength="30" placeholder={s.namePlaceholder} autocomplete="off" />
        </div>
        <div class="field">
          <label data-for="age">{s.ageLabel}</label>
          <input type="number" data-f="age" inputmode="numeric" min="0" max="120" step="1" />
        </div>
        <div class="field">
          <label data-for="perYear">{s.perYearLabel}</label>
          <input type="number" data-f="perYear" inputmode="decimal" min="0" max="365" step="any" />
        </div>
        <button class="btn ghost small lw-remove" type="button" aria-label={s.remove} title={s.remove}><Icon name="X" size={18} /></button>
      </div>
      <p class="lw-visits" data-out="visits"></p>
      <p class="hint lw-visits-more" data-out="more"></p>
    </li>
  </template>

  <p class="hint lw-save">{s.saveHint}</p>
</div>

<script>
  import { $, $$, copyText, downloadBlob, flashButton, loadPref, savePref } from '../../lib/client';
  import { readI18n } from '../../i18n/client';
  import { formatInteger, plural, t } from '../../i18n/format';
  import { LOCALE_INFO } from '../../i18n/locales';
  import { toUTCDate } from '../date-diff/logic';
  import type { CountKey, LegendKey, Strings } from './i18n';
  import {
    cellAt,
    cellRange,
    checkBirth,
    decodeShare,
    encodeShare,
    gridLayout,
    lifeOf,
    MAX_PEOPLE,
    normalizeSettings,
    progressOf,
    remainingOf,
    stageBounds,
    stageOf,
    STAGES,
    visitsLeft,
    WEEKS_PER_ROW,
    type GridLayout,
    type Life,
    type Settings,
    type Stage,
    type YMD,
  } from './logic';
  import { drawGrid, drawPoster, swatchColor, type GridModel } from './draw';

  const root = $('[data-tool="life-in-weeks"]');
  const { locale, s } = readI18n<Strings['client']>(root);
  const intl = LOCALE_INFO[locale].intl;
  const prefKey = `life-in-weeks:${locale}`;

  const birthInput = $<HTMLInputElement>('#lw-birth', root);
  const lifespanInput = $<HTMLInputElement>('#lw-lifespan', root);
  const errorEl = $('#lw-error', root);
  const hero = $('#lw-hero', root);
  const pctInt = $('#lw-pct-int', root);
  const pctFrac = $('#lw-pct-frac', root);
  const bar = $('#lw-bar', root);
  const fill = $('#lw-fill', root);
  const livedEl = $('#lw-lived', root);
  const aheadEl = $('#lw-ahead', root);
  const nowEl = $('#lw-now', root);
  const bonusEl = $('#lw-bonus', root);
  const legendItems = $$<HTMLLIElement>('#lw-legend li', root);
  const wrap = $('#lw-wrap', root);
  const canvas = $<HTMLCanvasElement>('#lw-canvas', root);
  const ctx = canvas.getContext('2d')!;
  const cellEl = $('#lw-cell', root);
  const downloadBtn = $<HTMLButtonElement>('#lw-download', root);
  const shareBtn = $<HTMLButtonElement>('#lw-share', root);
  const shareLabel = $('#lw-share-label', root);
  const leftTitle = $('#lw-left-title', root);
  const leftSection = $('.lw-left', root);
  const countsNote = $('#lw-counts-note', root);
  const stagesBox = $<HTMLInputElement>('#lw-stages-on', root);
  const stageFieldsEl = $('#lw-stage-fields', root);
  const stagesNote = $('#lw-stages-note', root);
  const stageInputs = $$<HTMLInputElement>('input[data-stage]', root);
  const peopleList = $<HTMLOListElement>('#lw-people', root);
  const personTpl = $<HTMLTemplateElement>('#lw-person-tpl', root);
  const addBtn = $<HTMLButtonElement>('#lw-add', root);
  const font = getComputedStyle(root).fontFamily;

  const pctFormat = new Intl.NumberFormat(intl, { minimumFractionDigits: 9, maximumFractionDigits: 9 });
  const posterPct = new Intl.NumberFormat(intl, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const shortDate = new Intl.DateTimeFormat(intl, { year: 'numeric', month: 'numeric', day: 'numeric', timeZone: 'UTC' });
  const longDate = new Intl.DateTimeFormat(intl, { dateStyle: 'long', timeZone: 'UTC' });
  const int = (n: number) => formatInteger(n, locale);

  let settings: Settings = normalizeSettings(decodeShare(location.hash), normalizeSettings(loadPref<unknown>(prefKey, null)));
  let life: Life | null = null;
  let layout: GridLayout | null = null;
  let dpr = 1;
  let hover = -1;
  let personSeq = 0;
  let lastPct = '';

  function localToday(now = new Date()): YMD {
    return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
  }

  function msOfDay(now = new Date()): number {
    return ((now.getHours() * 60 + now.getMinutes()) * 60 + now.getSeconds()) * 1000 + now.getMilliseconds();
  }

  /* ---------- Form ---------- */
  function addPersonRow(person: { name: string; age: number | ''; perYear: number | '' }) {
    const li = personTpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    const id = `lw-p${++personSeq}`;
    for (const input of $$<HTMLInputElement>('input[data-f]', li)) {
      const key = input.dataset.f as 'name' | 'age' | 'perYear';
      input.id = `${id}-${key}`;
      input.value = String(person[key]);
      li.querySelector<HTMLLabelElement>(`label[data-for="${key}"]`)!.htmlFor = input.id;
    }
    peopleList.append(li);
    addBtn.disabled = peopleList.children.length >= MAX_PEOPLE;
    return li;
  }

  function writeForm() {
    birthInput.value = settings.birth;
    lifespanInput.value = String(settings.lifespan);
    stagesBox.checked = settings.stagesOn;
    for (const input of stageInputs) input.value = String(settings[input.dataset.stage as 'schoolStart' | 'schoolEnd' | 'retire']);
    peopleList.replaceChildren();
    for (const p of settings.people) addPersonRow(p);
    addBtn.disabled = peopleList.children.length >= MAX_PEOPLE;
  }

  function readPerson(li: HTMLElement) {
    const field = (key: string) => li.querySelector<HTMLInputElement>(`input[data-f="${key}"]`)!.value;
    const numOrNull = (v: string) => (v.trim() === '' || !Number.isFinite(Number(v)) ? null : Number(v));
    return { name: field('name').trim(), age: numOrNull(field('age')), perYear: numOrNull(field('perYear')) };
  }

  function readForm(): Settings {
    const stages = Object.fromEntries(stageInputs.map((i) => [i.dataset.stage, i.value]));
    return normalizeSettings(
      {
        birth: birthInput.value,
        lifespan: lifespanInput.value,
        stagesOn: stagesBox.checked,
        ...stages,
        // Rows with a blank age or count are kept on screen but not saved.
        people: $$('li', peopleList).map(readPerson),
      },
      settings,
    );
  }

  function onChange() {
    settings = readForm();
    savePref(prefKey, settings);
    // A shared link describes the sharer's settings; once edited, drop it from the address bar.
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    update();
  }

  /* ---------- Rendering ---------- */
  function model(): GridModel {
    return {
      rows: life?.rows ?? settings.lifespan,
      lifespan: settings.lifespan,
      cell: life ? life.cell : -1,
      stages: settings.stagesOn ? stageBounds(settings) : null,
      hover,
    };
  }

  function legendKeys(): string[] {
    const keys: string[] = settings.stagesOn ? [...STAGES, 'current'] : ['lived', 'current', 'ahead'];
    if (life?.passed) keys.push('bonus');
    return keys;
  }

  function legendLabel(key: string): string {
    return key in s.legend ? s.legend[key as LegendKey] : s.stages[key as Stage];
  }

  function sizeCanvas() {
    dpr = Math.min(3, Math.max(1, window.devicePixelRatio || 1));
    const rows = model().rows;
    const opts = { gutter: Math.round(24 * dpr), top: Math.round(16 * dpr), maxPitch: 11 * dpr };
    const edge = Math.ceil(4 * dpr); // room for the ring around a cell on the right or bottom edge
    const available = Math.floor(wrap.clientWidth * dpr) - edge;
    let l = gridLayout(available, rows, opts);
    // Keep the canvas a whole number of CSS pixels wide so it maps 1:1 onto device pixels.
    if (Number.isInteger(dpr) && (l.width + edge) % dpr) l = gridLayout(available, rows, { ...opts, gutter: opts.gutter + dpr - ((l.width + edge) % dpr) });
    layout = l;
    const w = l.width + edge;
    const h = l.height + edge;
    if (canvas.width !== w) canvas.width = w;
    if (canvas.height !== h) canvas.height = h;
    canvas.style.width = `${w / dpr}px`;
    canvas.style.height = `${h / dpr}px`;
  }

  function draw() {
    if (!layout) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawGrid(ctx, layout, model(), { font, labelSize: Math.round(10 * dpr), ring: 1.5 * dpr });
  }

  function renderSummary() {
    hero.classList.toggle('is-empty', !life);
    lastPct = '';
    if (!life) {
      for (const el of [livedEl, aheadEl, nowEl]) el.textContent = '';
      bonusEl.hidden = true;
      pctInt.textContent = '–';
      pctFrac.textContent = '';
      fill.style.transform = 'scaleX(0)';
      return;
    }
    livedEl.textContent = plural(locale, life.weeksLived, s.livedWeeks);
    aheadEl.textContent = plural(locale, life.weeksLeft, s.aheadWeeks);
    nowEl.textContent = (life.isBirthday ? s.birthday : '') + t(s.nowLine, { age: int(life.age), week: int(life.weeksLived + 1) });
    bonusEl.hidden = !life.passed;
    bonusEl.textContent = t(s.bonusLine, { lifespan: settings.lifespan });
  }

  function renderCounts() {
    const left = life ? remainingOf(life) : null;
    leftTitle.textContent = t(s.leftTitle, { lifespan: settings.lifespan });
    countsNote.textContent = t(s.countsNote, { lifespan: settings.lifespan });
    for (const key of s.countKeys as CountKey[]) {
      const n = left ? left[key] : null;
      $(`#lw-n-${key}`, root).textContent = n === null ? '–' : int(n);
      $(`#lw-u-${key}`, root).textContent = plural(locale, n ?? 2, s.counts[key].label);
    }
    // Past the lifespan setting every count is 0; the hero already says so, warmly.
    leftSection.hidden = !!life?.passed;
  }

  function renderStages() {
    stageFieldsEl.hidden = !settings.stagesOn;
    stagesNote.hidden = !settings.stagesOn;
    const keys = new Set(legendKeys());
    for (const li of legendItems) li.hidden = !keys.has(li.dataset.key ?? '');
  }

  function renderVisits() {
    const daysLeft = life ? life.daysLeft : 0;
    for (const li of $$('li', peopleList)) {
      const p = readPerson(li);
      const out = $('[data-out="visits"]', li);
      const more = $('[data-out="more"]', li);
      li.classList.remove('is-bonus', 'is-empty');
      if (p.age === null || p.perYear === null) {
        li.classList.add('is-empty');
        out.textContent = s.visitsEmpty;
        more.textContent = '';
        continue;
      }
      const v = visitsLeft({ age: p.age, perYear: p.perYear }, settings.lifespan, daysLeft);
      const years = Math.round(v.years);
      if (v.bonus) {
        li.classList.add('is-bonus');
        out.textContent = t(s.visitsBonus, { lifespan: settings.lifespan });
        more.textContent = '';
      } else if (p.perYear <= 0) {
        out.textContent = plural(locale, years, s.visitsZero);
        more.textContent = '';
      } else {
        out.textContent = plural(locale, v.visits, p.name ? s.visitsNamed : s.visits, { name: p.name });
        more.textContent = years > 0 ? plural(locale, years, s.visitsMore, { m: int(years) }) : '';
      }
    }
  }

  function describeCell(index: number): string {
    if (!life || index < 0) return s.cellHint;
    const row = Math.floor(index / WEEKS_PER_ROW);
    const col = index % WEEKS_PER_ROW;
    const { from, to } = cellRange(life.birth, row, col);
    const a = toUTCDate(from);
    const b = toUTCDate(to);
    const range = typeof shortDate.formatRange === 'function' ? shortDate.formatRange(a, b) : `${shortDate.format(a)} – ${shortDate.format(b)}`;
    const parts = [t(s.cellInfo, { age: int(row), week: col + 1, range })];
    parts.push(s.cellStatus[index < life.cell ? 'lived' : index === life.cell ? 'current' : 'ahead']);
    if (row >= settings.lifespan) parts.push(s.legend.bonus);
    else if (settings.stagesOn) parts.push(s.stages[stageOf(row, stageBounds(settings))]);
    return parts.join(s.sep);
  }

  function update() {
    const check = checkBirth(birthInput.value, localToday());
    if ('error' in check) {
      life = null;
      errorEl.textContent = s.errors[check.error];
      errorEl.hidden = false;
    } else {
      life = lifeOf(check.birth, settings.lifespan, localToday());
      errorEl.hidden = true;
    }
    downloadBtn.disabled = shareBtn.disabled = !life;
    hover = -1;
    cellEl.textContent = s.cellHint;
    renderSummary();
    renderCounts();
    renderStages();
    renderVisits();
    const rows = model().rows;
    canvas.setAttribute(
      'aria-label',
      t(s.canvasAria, { total: int(rows * WEEKS_PER_ROW), lived: int(life ? Math.min(life.cell, rows * WEEKS_PER_ROW) : 0) }),
    );
    sizeCanvas();
    draw();
    frame();
  }

  /* ---------- Live percentage ---------- */
  function frame() {
    if (!life) return;
    const now = new Date();
    const today = localToday(now);
    if (today.d !== life.today.d || today.m !== life.today.m || today.y !== life.today.y) return update(); // midnight
    const p = progressOf(life, msOfDay(now));
    const parts = (life.passed ? posterPct : pctFormat).formatToParts(p * 100).filter((x) => !life!.passed || x.type === 'integer' || x.type === 'group');
    const cut = parts.findIndex((x) => x.type === 'decimal');
    const head = parts.slice(0, cut < 0 ? parts.length : cut).map((x) => x.value).join('');
    const tail = cut < 0 ? '' : parts.slice(cut).map((x) => x.value).join('');
    if (head + tail === lastPct) return;
    lastPct = head + tail;
    pctInt.textContent = head;
    pctFrac.textContent = tail;
    fill.style.transform = `scaleX(${p})`;
    bar.setAttribute('aria-valuenow', String(Math.floor(p * 100)));
  }

  function loop() {
    frame();
    requestAnimationFrame(loop);
  }

  /* ---------- Hover / tap ---------- */
  function pointAt(e: PointerEvent): number {
    if (!layout) return -1;
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) * (canvas.width / rect.width);
    const y = (e.clientY - rect.top) * (canvas.height / rect.height);
    const cell = cellAt(layout, x, y);
    return cell ? cell.row * WEEKS_PER_ROW + cell.col : -1;
  }

  function setHover(index: number) {
    if (index === hover) return;
    hover = index;
    cellEl.textContent = describeCell(index);
    draw();
  }

  canvas.addEventListener('pointermove', (e) => setHover(pointAt(e)));
  canvas.addEventListener('pointerdown', (e) => setHover(pointAt(e)));
  canvas.addEventListener('pointerleave', (e) => {
    if (e.pointerType === 'mouse') setHover(-1);
  });

  /* ---------- Poster + share link ---------- */
  downloadBtn.addEventListener('click', () => {
    if (!life) return;
    const p = progressOf(life, msOfDay());
    const left = remainingOf(life);
    const poster = drawPoster(
      { ...model(), hover: -1 },
      p,
      {
        title: s.posterTitle,
        subtitle: t(s.posterSub, { date: longDate.format(toUTCDate(life.birth)), lifespan: settings.lifespan }),
        percent: `${posterPct.format(p * 100)}%`,
        percentLabel: s.posterLived,
        lived: plural(locale, life.weeksLived, s.livedWeeks),
        ahead: plural(locale, life.weeksLeft, s.aheadWeeks),
        note: life.passed ? t(s.bonusLine, { lifespan: settings.lifespan }) : undefined,
        legend: legendKeys().map((k) => ({ label: legendLabel(k), color: swatchColor(k) })),
        countsTitle: life.passed ? undefined : t(s.leftTitle, { lifespan: settings.lifespan }),
        counts: life.passed
          ? []
          : (s.countKeys as CountKey[]).map((k) => ({
              value: int(left[k]) + (s.counts[k].suffix ?? ''),
              label: plural(locale, left[k], s.counts[k].label),
            })),
        brand: root.dataset.brand ?? '',
        url: root.dataset.url ?? '',
      },
      font,
    );
    poster.toBlob((blob) => blob && downloadBlob(blob, s.fileName), 'image/png');
  });

  shareBtn.addEventListener('click', async () => {
    if (!life) return;
    const url = `${location.origin}${location.pathname}#${encodeShare(settings)}`;
    if (await copyText(url)) flashButton(shareLabel);
  });

  /* ---------- Events ---------- */
  birthInput.addEventListener('input', onChange);
  birthInput.addEventListener('change', onChange);
  lifespanInput.addEventListener('input', onChange);
  stagesBox.addEventListener('change', onChange);
  for (const input of stageInputs) input.addEventListener('input', onChange);
  peopleList.addEventListener('input', onChange);
  peopleList.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.lw-remove');
    if (!btn) return;
    btn.closest('li')?.remove();
    addBtn.disabled = peopleList.children.length >= MAX_PEOPLE;
    onChange();
  });
  addBtn.addEventListener('click', () => {
    if (peopleList.children.length >= MAX_PEOPLE) return;
    const li = addPersonRow({ name: '', age: '', perYear: 12 });
    renderVisits();
    li.querySelector<HTMLInputElement>('input[data-f="name"]')?.focus();
  });

  let resizeQueued = false;
  new ResizeObserver(() => {
    if (resizeQueued) return;
    resizeQueued = true;
    requestAnimationFrame(() => {
      resizeQueued = false;
      sizeCanvas();
      draw();
    });
  }).observe(wrap);

  birthInput.max = `${localToday().y}-${String(localToday().m).padStart(2, '0')}-${String(localToday().d).padStart(2, '0')}`;
  writeForm();
  update();
  loop();
</script>

