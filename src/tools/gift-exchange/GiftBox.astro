---
// One wrapped present. A parent sets --gift and --ribbon; Tool.astro animates .gift-lid and .gift-body.
---

<svg class="gift" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <g class="gift-body">
    <path d="M14 46 H86 V89 a5 5 0 0 1 -5 5 H19 a5 5 0 0 1 -5 -5 Z" fill="var(--gift)"></path>
    <rect x="14" y="46" width="72" height="9" fill="rgb(0 0 0 / 0.14)"></rect>
    <rect x="43" y="46" width="14" height="48" fill="var(--ribbon)"></rect>
  </g>
  <g class="gift-lid">
    <rect x="8" y="32" width="84" height="18" rx="4" fill="var(--gift)"></rect>
    <rect x="8" y="32" width="84" height="18" rx="4" fill="rgb(255 255 255 / 0.18)"></rect>
    <rect x="43" y="32" width="14" height="18" fill="var(--ribbon)"></rect>
    <path d="M50 32 C 38 8, 14 10, 22 24 C 26 31, 42 32, 50 32 Z" fill="var(--ribbon)"></path>
    <path d="M50 32 C 62 8, 86 10, 78 24 C 74 31, 58 32, 50 32 Z" fill="var(--ribbon)"></path>
    <path d="M47 30 C 39 19, 26 18, 28 24 C 30 28, 40 30, 47 30 Z" fill="rgb(0 0 0 / 0.16)"></path>
    <path d="M53 30 C 61 19, 74 18, 72 24 C 70 28, 60 30, 53 30 Z" fill="rgb(0 0 0 / 0.16)"></path>
    <rect x="44" y="25" width="12" height="9" rx="3" fill="var(--ribbon)"></rect>
    <rect x="44" y="25" width="12" height="9" rx="3" fill="rgb(0 0 0 / 0.1)"></rect>
  </g>
</svg>

<style>
  .gift {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .gift-lid,
  .gift-body {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
</style>
