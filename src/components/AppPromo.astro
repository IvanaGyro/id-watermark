---
// A house promotion for one of the site owner's own apps. A static card with a plain store link:
// no AdSense, no tracking script, no popup. Space is fixed so it never shifts the layout.
import { fishingFestival, promoUrl, type AppPromo } from '../config/promos';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  /** Where the card sits; sent as the Play install referrer campaign. */
  placement: string;
  promo?: AppPromo;
  class?: string;
}

const { locale, placement, promo = fishingFestival, class: className } = Astro.props;
const text = promo.text[locale];
const href = promoUrl(promo, locale, placement);
---

<aside class:list={['app-promo', className]} aria-label={text.name} data-promo={promo.id}>
  <a class="app-promo-art" href={href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <img src={promo.image.src} width={promo.image.width} height={promo.image.height} alt="" loading="lazy" decoding="async" />
  </a>
  <div class="app-promo-body">
    <span class="app-promo-badge">{text.badge}</span>
    <div class="app-promo-head">
      <img class="app-promo-icon" src={promo.icon.src} width="44" height="44" alt="" loading="lazy" decoding="async" />
      <strong class="app-promo-name">{text.name}</strong>
    </div>
    <p class="app-promo-pitch">{text.pitch}</p>
    <a class="app-promo-cta" href={href} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"
        ></path>
      </svg>
      <span>{text.cta}</span>
    </a>
  </div>
</aside>

<style>
  .app-promo {
    display: grid;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, #1a8fd6 30%, var(--border));
    border-radius: var(--radius);
    background: linear-gradient(180deg, #eef8ff, var(--surface) 70%);
    box-shadow: var(--shadow-sm);
  }
  .app-promo-art {
    display: block;
    aspect-ratio: 640 / 312;
    background: #8fd0f5;
  }
  .app-promo-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .app-promo-body {
    display: grid;
    gap: 8px;
    padding: 12px 14px 14px;
  }
  .app-promo-badge {
    justify-self: start;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: #0c5e8f;
    background: #d9effc;
  }
  .app-promo-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .app-promo-icon {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }
  .app-promo-name {
    font-size: 16px;
    line-height: 1.35;
  }
  .app-promo-pitch {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .app-promo-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: #15171c;
    transition: background 0.15s;
  }
  .app-promo-cta:hover {
    background: #2b2f38;
    color: #fff;
    text-decoration: none;
  }
  .app-promo-cta:focus-visible {
    outline: none;
    box-shadow: var(--focus);
  }
</style>
